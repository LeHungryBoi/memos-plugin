{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch: memos language card",
      "detail": "Rebuild the single-file Memos plugin whenever src/ changes. Single instance only.",
      "type": "shell",
      "command": "npm run watch",
      "options": {
        "cwd": "${workspaceFolder}/memos-plugin"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
